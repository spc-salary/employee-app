# برنامج بسيط لإدارة الموظفين (employee_app)

employees = []

def add_employee():
    name = input("أدخل اسم الموظف: ")
    position = input("أدخل المسمى الوظيفي: ")
    department = input("أدخل القسم: ")

    employee = {
        "name": name,
        "position": position,
        "department": department
    }
    employees.append(employee)
    print(f"تم إضافة الموظف {name} بنجاح!\n")

def show_employees():
    if not employees:
        print("لا يوجد موظفون مسجلون حالياً.\n")
        return

    print("\n--- قائمة الموظفين ---")
    for index, emp in enumerate(employees, start=1):
        print(f"{index}. الاسم: {emp['name']} | الوظيفة: {emp['position']} | القسم: {emp['department']}")
    print("-" * 25 + "\n")

def main():
    while True:
        print("1. إضافة موظف جديد")
        print("2. عرض جميع الموظفين")
        print("3. خروج")

        choice = input("اختر الرقم المناسب (1-3): ")

        if choice == '1':
            add_employee()
        elif choice == '2':
            show_employees()
        elif choice == '3':
            print("شكراً لاستخدام تطبيق إدارة الموظفين. إلى اللقاء!")
            break
        else:
            print("اختيار غير صحيح، يرجى المحاولة مرة أخرى.\n")

if __name__ == "__main__":
    main()
